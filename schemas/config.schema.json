{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reusable-workflow/config.schema.json",
  "title": "WorkflowConfig",
  "type": "object",
  "required": ["templateVersion", "project", "workflow", "commands", "evidence", "policies"],
  "properties": {
    "templateVersion": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "description", "owner", "timezone"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["phases", "taskStatuses", "doneRequires"],
      "properties": {
        "phases": { "type": "array", "items": { "type": "string" } },
        "taskStatuses": {
          "type": "array",
          "items": {
            "enum": ["TODO", "DOING", "BLOCKED", "DONE", "CANCELLED"]
          }
        },
        "doneRequires": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commands": { "type": "object" },
    "evidence": { "type": "object" },
    "policies": { "type": "object" }
  }
}
