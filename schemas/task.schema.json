{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reusable-workflow/task.schema.json",
  "title": "WorkflowTask",
  "type": "object",
  "required": ["id", "title", "phase", "status", "acceptance", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^T-[A-Za-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": ["discover", "define", "decide", "build", "verify", "close"]
    },
    "status": {
      "enum": ["TODO", "DOING", "BLOCKED", "DONE", "CANCELLED"]
    },
    "profile": {
      "enum": ["lite", "standard", "critical"]
    },
    "owner": { "type": "string" },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "priority": {
      "enum": ["low", "normal", "high", "urgent"]
    },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array" }
  }
}
